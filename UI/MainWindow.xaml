<Window x:Class="Colmillo.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Colmillo" Width="1180" Height="760" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" FontFamily="{StaticResource Sans}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        Icon="/Assets/colmillo.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Logo arriba del sidebar, dentro de la franja arrastrable -->
        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Margin="22,18,0,0" Orientation="Horizontal"
                    VerticalAlignment="Top" IsHitTestVisible="False">
            <Image Source="/Assets/colmillo.ico" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="Colmillo" Margin="11,0,0,1" VerticalAlignment="Center" FontFamily="{StaticResource Display}"
                       FontSize="21" FontWeight="Bold" Foreground="{DynamicResource Wordmark}" />
        </StackPanel>

        <!-- Botones de ventana -->
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimizar" />
            <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximizar" />
            <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Cerrar a la bandeja" />
        </StackPanel>

        <!-- Sidebar -->
        <DockPanel Grid.Row="1" Grid.Column="0" Margin="12,30,12,16" LastChildFill="False">
            <StackPanel DockPanel.Dock="Top" x:Name="Nav">
                <RadioButton Style="{StaticResource NavPill}" Tag="&#xEC4A;" Content="Rendimiento" GroupName="nav" Checked="Nav_Checked" x:Name="NavPerformance" />
                <RadioButton Style="{StaticResource NavPill}" Tag="&#xE706;" Content="Iluminación" GroupName="nav" Checked="Nav_Checked" />
                <RadioButton Style="{StaticResource NavPill}" Tag="&#xE962;" Content="Botones" GroupName="nav" Checked="Nav_Checked" />
                <RadioButton Style="{StaticResource NavPill}" Tag="&#xE7C8;" Content="Macros" GroupName="nav" Checked="Nav_Checked" />
                <RadioButton Style="{StaticResource NavPill}" Tag="&#xE7C9;" Content="Puntero de Windows" GroupName="nav" Checked="Nav_Checked" />
            </StackPanel>

            <RadioButton DockPanel.Dock="Bottom" Style="{StaticResource NavPill}" Tag="&#xE713;" Content="Ajustes"
                         GroupName="nav" Checked="Nav_Checked" Margin="0" />

            <!-- Estado del mouse -->
            <Border DockPanel.Dock="Bottom" Margin="0,0,0,10" Padding="12,10" CornerRadius="{StaticResource RadiusBox}"
                    Background="{DynamicResource PillHover}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="34" Height="34">
                        <Ellipse Fill="{DynamicResource AccentSoft}" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE962;" FontSize="16" Foreground="{DynamicResource Accent600}" />
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Fill="{DynamicResource Ink300}" Stroke="{DynamicResource Bg}" StrokeThickness="2" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Razer Cobra" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Ink800}" />
                        <TextBlock x:Name="StatusText" Text="Buscando..." FontSize="11.5" Foreground="{DynamicResource Ink400}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DockPanel>

        <!-- Lienzo: esquina superior izquierda redondeada, sin margen abajo ni a la derecha. -->
        <Border Grid.Row="1" Grid.Column="1" CornerRadius="26,0,0,0" Background="{DynamicResource Canvas}"
                BorderBrush="{DynamicResource Line}" BorderThickness="1,1,0,0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Avisos (Synapse abierto, mouse desconectado) -->
                <Border x:Name="Banner" Visibility="Collapsed" Margin="28,22,28,0" Padding="16,12"
                        CornerRadius="{StaticResource RadiusBox}" Background="{DynamicResource WarnBg}">
                    <DockPanel>
                        <Button x:Name="BannerAction" DockPanel.Dock="Right" Style="{StaticResource Outline}" Height="32"
                                Click="BannerAction_Click" Margin="12,0,0,0" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="16" Foreground="{DynamicResource Warn}"
                                   DockPanel.Dock="Left" Margin="0,0,12,0" />
                        <TextBlock x:Name="BannerText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Warn}" />
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ContentControl x:Name="Page" Margin="32,26,32,32" Focusable="False" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Dialogo de confirmacion propio. Cubre tambien la franja de titulo: sin
             IsHitTestVisibleInChrome, un clic ahi arrastraria la ventana en vez de
             tocar el velo (la franja la decide WindowChrome por pixel, no el z-index). -->
        <Grid x:Name="Dialog" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed"
              WindowChrome.IsHitTestVisibleInChrome="True" Opacity="0">
            <Border Background="#66000000" MouseLeftButtonDown="DialogVeil_Click" />
            <Border Width="420" Padding="24,22" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="{StaticResource RadiusPanel}" Background="{DynamicResource GlassStrong}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="DialogScale" ScaleX="0.97" ScaleY="0.97" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Color="#000000" Opacity="0.3" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="38" Height="38">
                            <Ellipse x:Name="DialogIconBg" Fill="{DynamicResource DangerBg}" />
                            <TextBlock x:Name="DialogIcon" Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="16"
                                       Foreground="{DynamicResource Danger}" />
                        </Grid>
                        <TextBlock x:Name="DialogTitle" Style="{StaticResource H2}" FontSize="17" Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="DialogText" Style="{StaticResource Sub}" FontSize="13.5" Margin="0,14,0,22" LineHeight="20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Outline}" Content="Cancelar" Click="DialogCancel_Click" Margin="0,0,10,0" IsCancel="True" />
                        <Button x:Name="DialogOk" Style="{StaticResource DangerButton}" Click="DialogOk_Click" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
