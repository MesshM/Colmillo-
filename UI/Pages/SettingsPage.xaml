<local:PageBase x:Class="Colmillo.UI.Pages.SettingsPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:Colmillo.UI.Pages">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource H1}" Text="Ajustes" />
        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,22" Text="Como se comporta Colmillo." />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Apariencia" Margin="0,0,0,14" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="theme" Content="Como Windows" Tag="sistema" Checked="Theme_Checked" x:Name="ThemeSystem" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="theme" Content="Claro" Tag="claro" Checked="Theme_Checked" x:Name="ThemeLight" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="theme" Content="Oscuro" Tag="oscuro" Checked="Theme_Checked" x:Name="ThemeDark" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Inicio y bandeja" Margin="0,0,0,14" />
                <CheckBox Style="{StaticResource Switch}" x:Name="Startup" Checked="Startup_Changed" Unchecked="Startup_Changed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="Iniciar con Windows" />
                        <TextBlock Style="{StaticResource Sub}" FontSize="12" Text="Arranca minimizado en la bandeja. Hace falta para macros y programas en botones." />
                    </StackPanel>
                </CheckBox>
                <CheckBox Style="{StaticResource Switch}" x:Name="Tray" Margin="0,14,0,0" Checked="Tray_Changed" Unchecked="Tray_Changed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="Al cerrar la ventana, seguir en la bandeja" />
                        <TextBlock Style="{StaticResource Sub}" FontSize="12" Text="La ventana se destruye y se libera su memoria; queda solo el icono." />
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Mouse" Margin="0,0,0,14" />
                <Grid x:Name="Info">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
                <WrapPanel Margin="0,16,0,0">
                    <Button Style="{StaticResource Outline}" Content="Volver a aplicar todo" Click="Reapply_Click" Margin="0,0,8,8" />
                    <Button Style="{StaticResource DangerButton}" Content="Restaurar valores de fábrica" Click="Factory_Click" Margin="0,0,8,8" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Privacidad" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource Sub}"
                           Text="Sin cuentas ni telemetría. Colmillo solo se conecta a internet cuando aprietas &quot;Buscar actualizaciones&quot;, y solo a GitHub: no envía nada de esta PC. Los ajustes viven en %APPDATA%\Colmillo\ajustes.json." />
                <Button Style="{StaticResource Outline}" Content="Abrir carpeta de ajustes" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OpenFolder_Click" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="/Assets/isotipo.png" Height="44" Margin="0,0,16,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Button DockPanel.Dock="Right" x:Name="CheckButton" Style="{StaticResource Outline}" Content="Buscar actualizaciones" Click="Updates_Click"
                        VerticalAlignment="Top" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" Style="{StaticResource H2}" />
                    <TextBlock x:Name="UpdateText" Style="{StaticResource Sub}" FontSize="12"
                               Text="Solo se conecta a GitHub cuando tú lo pides." />
                    <Button x:Name="InstallButton" Style="{StaticResource Cta}" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Visibility="Collapsed" Click="Install_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</local:PageBase>
