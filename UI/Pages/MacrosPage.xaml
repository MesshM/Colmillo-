<local:PageBase x:Class="Colmillo.UI.Pages.MacrosPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:Colmillo.UI.Pages">
    <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource H1}" Text="Macros" />
        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,22"
                   Text="Secuencias de teclas, texto y clics. Graba una o ármala paso a paso, y después asígnala a un botón en Botones." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,18,0" VerticalAlignment="Top">
                <StackPanel>
                    <Button Style="{StaticResource Cta}" Click="New_Click" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource OnCta}" />
                            <TextBlock Text="Nuevo macro" />
                        </StackPanel>
                    </Button>
                    <ListBox x:Name="List" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RowItem}"
                             SelectionChanged="List_SelectionChanged" />
                    <TextBlock x:Name="Empty" Style="{StaticResource Sub}" TextAlignment="Center" Margin="0,18"
                               Text="Todavía no hay macros" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" x:Name="Editor" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="NOMBRE" />
                    <TextBox x:Name="NameBox" TextChanged="Name_Changed" />

                    <TextBlock Style="{StaticResource Label}" Text="AL APRETAR EL BOTON" Margin="2,18,0,6" />
                    <WrapPanel>
                        <RadioButton Style="{StaticResource Segment}" GroupName="mode" Content="Una vez" Tag="Once" Checked="Mode_Checked" x:Name="ModeOnce" Margin="0,0,6,6" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="mode" Content="Mientras lo mantengo" Tag="WhileHeld" Checked="Mode_Checked" x:Name="ModeHeld" Margin="0,0,6,6" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="mode" Content="Prender / apagar" Tag="Toggle" Checked="Mode_Checked" x:Name="ModeToggle" Margin="0,0,6,6" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="mode" Content="Repetir" Tag="Repeat" Checked="Mode_Checked" x:Name="ModeRepeat" Margin="0,0,6,6" />
                        <TextBox x:Name="RepeatBox" Width="64" TextAlignment="Center" TextChanged="Repeat_Changed" ToolTip="Veces" />
                    </WrapPanel>

                    <!-- Grabacion y pasos -->
                    <Grid Margin="0,20,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RecordButton" Style="{StaticResource Cta}" Click="Record_Click" MinWidth="130">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="RecordDot" Width="10" Height="10" Fill="{DynamicResource OnCta}" Margin="0,0,9,0" />
                                <TextBlock x:Name="RecordText" Text="Grabar" />
                            </StackPanel>
                        </Button>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                            <CheckBox Style="{StaticResource Switch}" x:Name="RecDelays" IsChecked="True" Margin="0,0,18,0">
                                <TextBlock Style="{StaticResource Body}" Text="Demoras reales" FontSize="12.5" />
                            </CheckBox>
                            <CheckBox Style="{StaticResource Switch}" x:Name="RecMouse">
                                <TextBlock Style="{StaticResource Body}" Text="Clics del mouse" FontSize="12.5" />
                            </CheckBox>
                        </WrapPanel>
                    </Grid>

                    <WrapPanel Margin="0,0,0,10">
                        <Button Style="{StaticResource Outline}" Content="+ Tecla" Click="AddKey_Click" Margin="0,0,8,8" Height="32" />
                        <Button Style="{StaticResource Outline}" Content="+ Texto" Click="AddText_Click" Margin="0,0,8,8" Height="32" />
                        <Button Style="{StaticResource Outline}" Content="+ Demora" Click="AddDelay_Click" Margin="0,0,8,8" Height="32" />
                        <Button Style="{StaticResource Outline}" Content="+ Clic" Click="AddClick_Click" Margin="0,0,8,8" Height="32" />
                        <TextBox x:Name="KeyCatcher" Width="190" Visibility="Collapsed" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 Text="Presiona una tecla..." PreviewKeyDown="KeyCatcher_KeyDown" LostFocus="KeyCatcher_LostFocus" Margin="0,0,8,8" />
                    </WrapPanel>

                    <Border CornerRadius="{StaticResource RadiusBox}" Background="{DynamicResource Fog}" Padding="6" MinHeight="120">
                        <Grid>
                            <ItemsControl x:Name="Steps" />
                            <TextBlock x:Name="NoSteps" Style="{StaticResource Sub}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="Sin pasos. Graba o agrega pasos con los botones de arriba." />
                        </Grid>
                    </Border>

                    <DockPanel Margin="0,18,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Click="Delete_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource Danger}" />
                                <TextBlock Text="Borrar macro" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Outline}" HorizontalAlignment="Left" Click="Test_Click" x:Name="TestButton">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock x:Name="TestText" Text="Probar en 3 s" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</local:PageBase>
