<local:PageBase x:Class="Colmillo.UI.Pages.ButtonsPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:Colmillo.UI.Pages"
                xmlns:c="clr-namespace:Colmillo.UI.Controls">
    <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource H1}" Text="Botones" />
        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,18"
                   Text="Lo que hace cada botón. Teclas, multimedia y DPI quedan grabados en el mouse; los macros y programas necesitan a Colmillo en la bandeja." />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <RadioButton Style="{StaticResource Segment}" GroupName="layer" Content="Capa normal" x:Name="LayerNormal" Checked="Layer_Checked" IsChecked="True" />
            <RadioButton Style="{StaticResource Segment}" GroupName="layer" Content="Capa Hypershift" x:Name="LayerHyper" Checked="Layer_Checked" />
            <TextBlock x:Name="LayerHint" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="460" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,18,0" VerticalAlignment="Top" Padding="16,22">
                <Grid Height="340">
                    <c:MouseDrawing x:Name="Drawing" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Canvas x:Name="Markers" Width="200" Height="320" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,18,0" VerticalAlignment="Top">
                <ListBox x:Name="List" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RowItem}"
                         SelectionChanged="List_SelectionChanged" />
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" x:Name="EditorCard">
                <StackPanel>
                    <TextBlock x:Name="EditorTitle" Style="{StaticResource H2}" />
                    <TextBlock x:Name="EditorSub" Style="{StaticResource Sub}" Margin="0,3,0,16" />

                    <TextBlock Style="{StaticResource Label}" Text="ACCIÓN" />
                    <ComboBox x:Name="KindBox" SelectionChanged="Kind_Changed" />

                    <StackPanel x:Name="Detail" Margin="0,16,0,0" />

                    <Button Style="{StaticResource Outline}" HorizontalAlignment="Left" Margin="0,20,0,0" Click="Reset_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Volver a la función de fábrica" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</local:PageBase>
