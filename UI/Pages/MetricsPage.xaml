<local:PageBase x:Class="Colmillo.UI.Pages.MetricsPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:Colmillo.UI.Pages">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource H1}" Text="Métricas" />
        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,22"
                   Text="FPS, gráfica, CPU y RAM encima de los juegos, como RivaTuner con Afterburner. No se inyecta nada en el juego: es una capa transparente que los antitrampas no tocan." />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <CheckBox Style="{StaticResource Switch}" x:Name="OverlayOn" Checked="Overlay_Changed" Unchecked="Overlay_Changed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="Mostrar en pantalla" />
                        <TextBlock x:Name="HotKeyText" Style="{StaticResource Sub}" FontSize="12" />
                    </StackPanel>
                </CheckBox>
                <CheckBox Style="{StaticResource Switch}" x:Name="OnlyGames" Margin="0,14,0,0" Checked="OnlyGames_Changed" Unchecked="OnlyGames_Changed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="Solo dentro de los juegos" />
                        <TextBlock Style="{StaticResource Sub}" FontSize="12"
                                   Text="Aparece cuando el driver de AMD cuenta FPS, es decir, con un juego 3D en primer plano." />
                    </StackPanel>
                </CheckBox>

                <TextBlock Style="{StaticResource Label}" Text="POSICIÓN" Margin="2,18,0,6" />
                <WrapPanel x:Name="Corners">
                    <RadioButton Style="{StaticResource Segment}" GroupName="corner" Content="Arriba izquierda" Tag="arriba-izq" Checked="Corner_Checked" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="corner" Content="Arriba derecha" Tag="arriba-der" Checked="Corner_Checked" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="corner" Content="Abajo izquierda" Tag="abajo-izq" Checked="Corner_Checked" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="corner" Content="Abajo derecha" Tag="abajo-der" Checked="Corner_Checked" />
                </WrapPanel>

                <Grid Margin="0,18,0,0">
                    <TextBlock Style="{StaticResource Label}" Text="TAMAÑO DEL TEXTO" Margin="2,0,0,6" />
                    <TextBlock x:Name="SizeValue" Style="{StaticResource Body}" HorizontalAlignment="Right" Foreground="{DynamicResource Accent600}" />
                </Grid>
                <Slider x:Name="FontSizeSlider" Minimum="10" Maximum="24" IsSnapToTickEnabled="True" TickFrequency="1"
                        ValueChanged="Size_Changed" PreviewMouseUp="Size_Released" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Qué mostrar" Margin="0,0,0,4" />
                <TextBlock x:Name="CpuNote" Style="{StaticResource Sub}" FontSize="12" Margin="0,0,0,10" />
                <StackPanel x:Name="Groups" />
            </StackPanel>
        </Border>
    </StackPanel>
</local:PageBase>
