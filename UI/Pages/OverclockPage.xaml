<local:PageBase x:Class="Colmillo.UI.Pages.OverclockPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:Colmillo.UI.Pages">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource H1}" Text="Overclock" />
        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,22"
                   Text="Modos automáticos del driver de AMD, los mismos que ofrece Gigabyte Control Center. Los aplica el driver: Colmillo los vuelve a poner al iniciar si otro programa los cambió." />

        <Border Style="{StaticResource Card}" x:Name="ModesCard">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Modo" Margin="0,0,0,4" />
                <TextBlock x:Name="CurrentText" Style="{StaticResource Sub}" FontSize="12" Margin="0,0,0,14" />
                <WrapPanel x:Name="Modes" />
                <TextBlock x:Name="ModeHint" Style="{StaticResource Sub}" FontSize="12.5" Margin="2,8,0,0" />
                <DockPanel Margin="0,16,0,0">
                    <TextBlock x:Name="ApplyStatus" Style="{StaticResource Sub}" FontSize="12" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Cómo funciona" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource Sub}"
                           Text="Silencioso baja el límite de potencia y el ruido; Equilibrado es el de fábrica; Rage sube el límite de potencia. El overclock automático lo calcula el driver para esta tarjeta en particular (tarda unos segundos) y queda guardado aunque cierres Colmillo. Si algo se pone inestable, vuelve a Equilibrado." />
                <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0"
                           Text="La curva de ventiladores propia se conserva: si el driver pide volver a fábrica para cambiar de modo, Colmillo la repone." />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" x:Name="Missing" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="No hay modos de tuning" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Sub}" Text="Hace falta una gráfica AMD y el driver Adrenalin (ADLX)." />
            </StackPanel>
        </Border>
    </StackPanel>
</local:PageBase>
