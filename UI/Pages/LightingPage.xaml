<local:PageBase x:Class="Colmillo.UI.Pages.LightingPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:Colmillo.UI.Pages"
                xmlns:c="clr-namespace:Colmillo.UI.Controls">
    <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource H1}" Text="Iluminación" />
        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,18"
                   Text="Luz del mouse y de la RAM, juntas o por separado. Los efectos los ejecuta cada dispositivo: siguen aunque Colmillo esté cerrado." />

        <!-- Dispositivos -->
        <WrapPanel x:Name="Devices" Margin="0,0,0,16" />

        <!-- Modo y destino -->
        <WrapPanel Margin="0,0,0,18">
            <RadioButton Style="{StaticResource Segment}" GroupName="mode" Content="Todos juntos" x:Name="ModeTogether" Checked="Mode_Checked" />
            <RadioButton Style="{StaticResource Segment}" GroupName="mode" Content="Por separado" x:Name="ModeSeparate" Checked="Mode_Checked" />
            <Rectangle Width="1" Height="22" Fill="{DynamicResource Line}" Margin="10,0,14,0" x:Name="TargetDivider" />
            <RadioButton Style="{StaticResource Segment}" GroupName="target" Content="Mouse" x:Name="TargetMouse" Checked="Target_Checked" />
            <RadioButton Style="{StaticResource Segment}" GroupName="target" Content="RAM" x:Name="TargetRam" Checked="Target_Checked" />
        </WrapPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Vista previa -->
            <Border Style="{StaticResource Card}" Margin="0,0,18,0" Padding="16,22" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Height="340">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox x:Name="MouseBox" Height="320" Margin="0,0,6,0">
                                <c:MouseDrawing x:Name="Preview" />
                            </Viewbox>
                            <Viewbox x:Name="RamBox" Height="230" VerticalAlignment="Center">
                                <c:RamDrawing x:Name="RamPreview" />
                            </Viewbox>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="PreviewLabel" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Efecto" Margin="0,0,0,4" />
                        <TextBlock x:Name="EffectsHint" Style="{StaticResource Sub}" FontSize="12" Margin="0,0,0,14" />
                        <WrapPanel x:Name="Effects" />

                        <StackPanel x:Name="BreathPanel" Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource Label}" Text="COLORES DE LA RESPIRACIÓN" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="br" Content="Un color" x:Name="BrOne" Checked="Breath_Checked" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="br" Content="Dos colores" x:Name="BrTwo" Checked="Breath_Checked" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="br" Content="Aleatorio" x:Name="BrRandom" Checked="Breath_Checked" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="SpeedPanel" Margin="0,10,0,0">
                            <TextBlock x:Name="SpeedLabel" Style="{StaticResource Label}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SpeedMin" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Slider Grid.Column="1" x:Name="Speed" Minimum="1" Maximum="5" IsSnapToTickEnabled="True" TickFrequency="1"
                                        ValueChanged="Speed_Changed" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" x:Name="SpeedMax" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,18,0,0" x:Name="ColorCard">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Color" Margin="0,0,0,14" />
                        <StackPanel x:Name="PalettePanel" Margin="0,0,0,16">
                            <CheckBox Style="{StaticResource Switch}" x:Name="UsePalette" Checked="UsePalette_Changed" Unchecked="UsePalette_Changed">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Body}" Text="Paleta propia" />
                                    <TextBlock Style="{StaticResource Sub}" FontSize="12" Text="Hasta 10 colores que la RAM recorre en orden. Elige uno para cambiarlo." />
                                </StackPanel>
                            </CheckBox>
                            <WrapPanel x:Name="PaletteChips" Margin="0,12,0,0" />
                        </StackPanel>
                        <c:ColorPicker x:Name="Color1" />
                        <StackPanel x:Name="Color2Panel" Margin="0,18,0,0">
                            <TextBlock Style="{StaticResource Label}" Text="SEGUNDO COLOR" />
                            <c:ColorPicker x:Name="Color2" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource H2}" Text="Brillo" />
                            <TextBlock x:Name="BrightnessValue" Style="{StaticResource Body}" HorizontalAlignment="Right" Foreground="{DynamicResource Accent600}" />
                        </Grid>
                        <Slider x:Name="Brightness" Minimum="0" Maximum="100" Margin="0,12,0,0" ValueChanged="Brightness_Changed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</local:PageBase>
