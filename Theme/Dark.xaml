<!-- Tema oscuro de GenI: grafito, paneles mas profundos que el fondo y "lo activo"
     en crema en vez de carmesi. Mismas claves que Light.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BgColor">#1B1C21</Color>
    <SolidColorBrush x:Key="Bg" Color="#1B1C21" />
    <SolidColorBrush x:Key="Warm100" Color="#131418" />
    <SolidColorBrush x:Key="Warm200" Color="#0E0F12" />

    <DrawingBrush x:Key="Canvas" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                            <GradientStop Offset="0" Color="#131418" />
                            <GradientStop Offset="0.6" Color="#111215" />
                            <GradientStop Offset="1" Color="#0E0F12" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.88,-0.08" GradientOrigin="0.88,-0.08" RadiusX="0.6" RadiusY="0.5">
                            <GradientStop Offset="0" Color="#E6303238" />
                            <GradientStop Offset="1" Color="#00303238" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="-0.06,1.08" GradientOrigin="-0.06,1.08" RadiusX="0.5" RadiusY="0.42">
                            <GradientStop Offset="0" Color="#CC24252B" />
                            <GradientStop Offset="1" Color="#0024252B" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <SolidColorBrush x:Key="Ink900" Color="#F4F5F8" />
    <SolidColorBrush x:Key="Ink800" Color="#E6E8EC" />
    <SolidColorBrush x:Key="Ink700" Color="#D4D6DB" />
    <SolidColorBrush x:Key="Ink600" Color="#A8AAB0" />
    <SolidColorBrush x:Key="Ink500" Color="#8E9096" />
    <SolidColorBrush x:Key="Ink400" Color="#75777D" />
    <SolidColorBrush x:Key="Ink300" Color="#5A5C61" />

    <Color x:Key="AccentColor">#E8DFC4</Color>
    <SolidColorBrush x:Key="Accent700" Color="#F2EBD6" />
    <SolidColorBrush x:Key="Accent600" Color="#E8DFC4" />
    <SolidColorBrush x:Key="Accent500" Color="#D6CCAE" />
    <SolidColorBrush x:Key="AccentSoft" Color="#26D6CCAE" />
    <SolidColorBrush x:Key="OnCta" Color="#1A1B20" />
    <LinearGradientBrush x:Key="CtaFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#EEE6CF" />
        <GradientStop Offset="1" Color="#DDD2B2" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Wordmark" StartPoint="0,0" EndPoint="1,0.4">
        <GradientStop Offset="0" Color="#F3EDDB" />
        <GradientStop Offset="1" Color="#D8C9A4" />
    </LinearGradientBrush>

    <!-- Sobre grafito el texto carmesi del imagotipo no se lee: isotipo + texto crema. -->
    <Visibility x:Key="ImagotipoVisibility">Collapsed</Visibility>
    <Visibility x:Key="WordmarkVisibility">Visible</Visibility>

    <SolidColorBrush x:Key="Line" Color="#3A3B41" />
    <SolidColorBrush x:Key="Track" Color="#3A3B41" />
    <SolidColorBrush x:Key="Fog" Color="#40585A60" />

    <LinearGradientBrush x:Key="Glass" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Offset="0" Color="#DB1E2026" />
        <GradientStop Offset="1" Color="#B816181D" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassStrong" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Offset="0" Color="#F522242B" />
        <GradientStop Offset="1" Color="#E6181A20" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassBorder" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="PillActive" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="PillHover" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Field" Color="#14FFFFFF" />
    <Color x:Key="ShadowColor">#000000</Color>
    <sys:Double x:Key="ShadowOpacity" xmlns:sys="clr-namespace:System;assembly=mscorlib">0.5</sys:Double>

    <SolidColorBrush x:Key="Danger" Color="#E7766A" />
    <SolidColorBrush x:Key="DangerBg" Color="#3A2424" />
    <SolidColorBrush x:Key="Ok" Color="#5CC48F" />
    <SolidColorBrush x:Key="OkBg" Color="#1F3A2D" />
    <SolidColorBrush x:Key="Warn" Color="#E8C27A" />
    <SolidColorBrush x:Key="WarnBg" Color="#3A3221" />
</ResourceDictionary>
