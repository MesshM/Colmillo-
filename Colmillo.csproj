<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Colmillo</AssemblyName>
    <RootNamespace>Colmillo</RootNamespace>
    <Version>0.5.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\colmillo.ico</ApplicationIcon>

    <!-- Memoria: la app pasa casi todo el tiempo en la bandeja. GC de estacion
         sin hilo concurrente y en modo "conserve" devuelve memoria al sistema. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\colmillo.ico" />
    <Resource Include="Assets\isotipo.png" />
    <Resource Include="Assets\imagotipo.png" />
    <!-- Modulo SMBus de PawnIO.Modules 0.2.11 (LGPL-2.1, Assets/PawnIO/COPYING). -->
    <EmbeddedResource Include="Assets\PawnIO\SmbusPIIX4.bin" LogicalName="Colmillo.SmbusPIIX4.bin" />
  </ItemGroup>

</Project>
